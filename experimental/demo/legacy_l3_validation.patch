+def test_cross_process_hash_seed_and_real_delays(tmp_path):
+    source = engine().build_oracle_workflow(run_oracle=True)
+    source_path = tmp_path / "source.json"
+    source.save_workflow(str(source_path))
+    code = '''
+import json, sys, time
+from fairy.controllers.engine import Engine
+from fairy.scenarios.registry import get_scenario_class
+from fairy.scenarios.workflow import Workflow
+from fairy.apps.app import App
+from fairy.tool_utils import AppTool
+delay=float(sys.argv[3])
+invoke=AppTool.__call__
+def delayed(self,*a,**kw):
+    time.sleep(delay)
+    return invoke(self,*a,**kw)
+AppTool.__call__=delayed
+e=Engine(agent=None,scenario=get_scenario_class(sys.argv[2])())
+w=e.replay_workflow(Workflow.load_workflow(sys.argv[1]))
+print(json.dumps({"workflow":w.to_dict(),"outcome":e.outcome_summary()}))
+'''
+    outputs = []
+    for hash_seed, delay in (("123", "0"), ("456", "0.01")):
+        raw = subprocess.check_output(
+            [sys.executable, "-c", code, str(source_path), SCENARIO, delay],
+            cwd=ROOT, env={**os.environ, "PYTHONHASHSEED": hash_seed}, text=True,
+        )
+        outputs.append(json.loads(raw))
+    assert outputs[0] == outputs[1]
+    assert outputs[0]["workflow"] == json.loads(source_path.read_text())
+
+
+def test_scenario_seed_is_effective():
+    observations = []
+    for seed in (7, 8, 7):
+        scenario = get_scenario_class(SCENARIO)(seed=seed)
+        e = Engine(agent=None, scenario=scenario)
+        scenario.setup()
+        e._register_scenario_apps()
+        sensor = next(a for a in scenario.apps if a.name == "SensorApp")
+        observations.append(sensor.read_soil_sensors())
+    assert observations[0] == observations[2]
+    assert observations[0] != observations[1]
