diff --git a/tests/test_l3_determinism.py b/tests/test_l3_determinism.py
new file mode 100644
index 0000000..e686126
--- /dev/null
+++ b/tests/test_l3_determinism.py
@@ -0,0 +1,100 @@
+"""Validation-copy regressions, independent of the new FAIRY L1 package."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+from copy import deepcopy
+
+from fairy.apps.app import App
+from fairy.controllers.engine import Engine
+from fairy.scenarios.registry import get_scenario_class
+from fairy.time_manager import TimeManager
+
+SCENARIO = "scenario_full_season_hb_dryr5r6_hn58_std_waterlimit"
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def engine():
+    return Engine(agent=None, scenario=get_scenario_class(SCENARIO)())
+
+
+def test_clock_and_ids_do_not_consume_wall_time_or_randomness():
+    clock = TimeManager()
+    clock.reset(100)
+    time.sleep(0.02)
+    assert clock.time() == 100
+    clock.add_offset(43200)
+    clock.add_offset(43200)
+    assert clock.time() == 86500
+    a, b = App("probe"), App("probe")
+    first = a.next_operation_id("inspection")
+    assert first != a.next_operation_id("inspection")
+    assert a.rng.random() == b.rng.random()
+    a.reset()
+    assert a.next_operation_id("inspection") == first
