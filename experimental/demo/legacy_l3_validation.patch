+def test_oracle_replay_exact_and_recomputed():
+    original = engine()
+    source = original.build_oracle_workflow(run_oracle=True)
+    replay_engine = engine()
+    replay = replay_engine.replay_workflow(source)
+    assert source.to_dict() == replay.to_dict()
+    assert original.outcome_summary() == replay_engine.outcome_summary()
+    assert source.dag["briefing"].wait_before_seconds == 5
+    assert source.dag["briefing"].time_before == original.start_time + 5
+    # A forged observation/time is not copied into computed tool results.
+    tampered = deepcopy(source)
+    weather = tampered.dag["o_weather_before_prep"]
+    weather.content["temp_c"] = -999
+    weather.time_after += 1000
+    actual = engine().replay_workflow(tampered)
+    assert actual.to_dict() != tampered.to_dict()
+    assert actual.to_dict() == replay.to_dict()
